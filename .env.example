# Server-only Supabase credentials. Do not use a NEXT_PUBLIC_ prefix for secret keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role key is supported as a fallback for older projects.
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=

# Optional notifications. Verify the sender domain before enabling.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vocorix Website <no-reply@vocorix.com>
LEAD_NOTIFICATION_EMAIL=swastik@vocorix.com
PUBLIC_SITE_URL=https://vocorix.com

# Reserved for future chat-provider work; the chatbot is not enabled yet.
CHAT_PROVIDER=
CHAT_MODEL=
